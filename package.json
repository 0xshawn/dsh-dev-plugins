{
  "name": "dsh-dev-plugins",
  "version": "0.7.0",
  "description": "Public DeepSeek Harness (dsh) dev plugins: non-localhost Web UI serving, browser notifications, workspace token statistics, browser control through a Chrome extension, and a newline-on-Enter composer, without patching the installed dsh.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "dev-plugins",
    "web",
    "reverse-proxy",
    "trusted-host",
    "web-token",
    "notifications",
    "token-usage",
    "statistics"
  ],
  "license": "MIT",
  "author": "shawn (https://github.com/0xshawn)",
  "homepage": "https://github.com/0xshawn/dsh-dev-plugins#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xshawn/dsh-dev-plugins.git"
  },
  "bugs": {
    "url": "https://github.com/0xshawn/dsh-dev-plugins/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bridge",
    "extension",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-0 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "@modelcontextprotocol/server": "^2.4.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  }
}
